generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductCategory {
  SCRIPT
  MLO
  VEHICLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum OrderStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

enum PaymentMethod {
  BKASH
  NAGAD
  BANK_TRANSFER
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.LongText
  access_token      String?  @db.LongText
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.LongText
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole     @default(BUYER)
  discordId     String?      @unique
  googleId      String?      @unique
  walletBalance Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  products      Product[]      @relation("ProductSeller")
  orders        Order[]        @relation("OrderBuyer")
  sellerProfile SellerProfile?
  reviews       Review[]       @relation("ReviewAuthor")
  verifiedOrders Order[]       @relation("OrderVerifier")
  downloadCodes DownloadCode[] @relation("UserDownloads")

  @@index([email])
}

model Product {
  id            String           @id @default(uuid())
  userId        String
  slug          String           @unique
  title         String
  description   String           @db.LongText
  category      ProductCategory
  price         Float
  screenshots   String[]         @db.Json
  files         String
  tags          String[]         @db.Json
  version       String           @default("1.0.0")
  compatibility String[]         @db.Json
  categoryId    String?
  status        ProductStatus    @default(DRAFT)
  downloads     Int              @default(0)
  featured      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  seller    User    @relation("ProductSeller", fields: [userId], references: [id])
  categoryObj Category? @relation("ProductCategory", fields: [categoryId], references: [id])
  orders    Order[]
  reviews   Review[]

  @@index([slug])
  @@index([categoryId, status])
  @@index([featured, status])
}

model Order {
  id             String        @id @default(uuid())
  userId         String
  productId      String
  status         OrderStatus   @default(PENDING)
  amount         Float
  paymentProof   String?
  adminNote      String?       @db.LongText
  downloadCode   String?       @unique
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  buyer      User     @relation("OrderBuyer", fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  verifier   User?    @relation("OrderVerifier", fields: [verifiedBy], references: [id])
  codeEntry  DownloadCode?

  @@index([userId, status])
  @@index([productId, status])
}

model SellerProfile {
  id         String       @id @default(uuid())
  userId     String       @unique
  bio        String?      @db.LongText
  discordTag String?
  status     SellerStatus @default(PENDING)
  approvedAt DateTime?
  payoutInfo String?      @db.LongText

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String     @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?    @db.LongText
  createdAt DateTime   @default(now())

  user    User    @relation("ReviewAuthor", fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model DownloadCode {
  id        String   @id @default(uuid())
  orderId   String   @unique
  userId    String
  code      String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation("UserDownloads", fields: [userId], references: [id])

  @@index([code])
  @@index([expiresAt])
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  icon   String
  order  Int     @default(0)

  products Product[] @relation("ProductCategory")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
