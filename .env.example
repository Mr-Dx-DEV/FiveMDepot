# FiveMDepot — Paddle settings for the pricing page (/pricing).
# Set these as real environment variables on the server (Plesk: Apache & nginx Settings ->
# "Additional directives": SetEnv PADDLE_ENVIRONMENT sandbox), or put the same names in
# config.local.php (see config.local.example.php). Environment variables win.

# Required: "sandbox" or "production". The pricing page refuses to load if this is unset,
# invalid, or doesn't match the client token — it never falls back to a default account.
PADDLE_ENVIRONMENT=sandbox

# Client-side token (Paddle > Developer tools > Authentication). Public: safe in the browser.
# Sandbox tokens start with test_, live tokens with live_.
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Server-only secrets: never sent to the browser ----

# Server API key (Paddle > Developer tools > Authentication > API keys). Sandbox keys contain _sdbx_.
# Needs: customer read, subscription read, customer portal session write (transaction write for store orders).
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook SIGNING secret of the notification destination (Paddle > Events > Notifications) —
# not the API key. Destination URL: https://YOUR-DOMAIN/api/pay/paddle-webhook.php
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxx
