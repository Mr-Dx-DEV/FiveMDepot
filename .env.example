# FiveMDepot — Lemon Squeezy settings (checkout + pricing page plans). See docs/LEMONSQUEEZY.md.
# Set these as real environment variables on the server (Plesk: Apache & nginx Settings ->
# "Additional directives": SetEnv LEMONSQUEEZY_STORE_ID 12345), or put the same names in
# config.local.php (see config.local.example.php). Environment variables win.

# "true" while testing (test API key + test products), "false" once the store is activated.
# It also selects the test or live variant IDs in core/plans.php.
LEMONSQUEEZY_TEST_MODE=true

# Your store's number (Settings > Stores).
LEMONSQUEEZY_STORE_ID=12345

# Variant of the single "FiveMDepot order" product used for store items (price is set per order).
LEMONSQUEEZY_ORDER_VARIANT_ID=123456

# ---- Server-only secrets: never sent to the browser ----

# API key (Settings > API). Test-mode and live keys are separate — match LEMONSQUEEZY_TEST_MODE.
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOi...

# Webhook signing secret: the secret you typed when creating the webhook (Settings > Webhooks).
# URL: https://YOUR-DOMAIN/api/pay/lemonsqueezy-webhook.php
LEMONSQUEEZY_WEBHOOK_SECRET=a-long-random-string
