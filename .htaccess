# FiveMDepot — caching & basic hardening (Apache / Plesk)


# Keep secrets and tooling private
<FilesMatch "^(config\.local\.php|config\.local\.example\.php|\.env.*|database\.sql|.*\.md|bump-version\.py)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(migrations|tools|docs|core)/

# Clean URLs for the pricing page and the post-checkout page (Paddle successUrl = /welcome)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(pricing|welcome)$ $1.html [L]
  # Legal pages, rendered on the server so they read without JavaScript (legal.php)
  RewriteRule ^(terms|privacy|refunds|refund-policy|contact)/?$ legal.php?slug=$1 [L,QSA]
  RewriteRule ^refund/?$ legal.php?slug=refunds [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # Short dashboard address: open the buyer dashboard (it sends logged-out visitors to sign in)
  RewriteRule ^dashboard/?$ /dashboard/buyer.html [R=302,L]
  # Anything that is not a real file, folder or clean .html page: a real 404 (404.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^ 404.php [L]
  # Folders without an index page (e.g. /dashboard/): 404, not the host's 403/500
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{REQUEST_FILENAME}/index.php !-f
  RewriteRule ^ 404.php [L]
</IfModule>

# Missing pages: a real 404 (not the host's error page)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # HTML pages: always check for a new version (CSS/JS links carry ?v= so updates load instantly)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Versioned CSS/JS and images can be cached by the browser
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
